# PDF Flux — Environment Variables
# Copy this file to .env.local to connect your Supabase project

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Key (public client key with RLS protection)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Supabase Service Role Key (ONLY for server-side administrative tasks; NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
